{
  "manifest_version": 3,
  "name": "AttnWall Web Bridge",
  "version": "0.3.6",
  "description": "Connect ChatGPT chats, Codex Web tasks and DeepSeek Web chats to your self-hosted AttnWall.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AttnWall Web Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "dom.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
